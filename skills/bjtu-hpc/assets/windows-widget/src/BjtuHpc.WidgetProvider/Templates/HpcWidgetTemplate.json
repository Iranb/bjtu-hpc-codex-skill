{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "BJTU HPC", "weight": "Bolder", "size": "Medium" },
            { "type": "TextBlock", "text": "${status}  |  ${updated}", "isSubtle": true, "spacing": "None", "size": "Small" }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            { "type": "TextBlock", "text": "${gpuFree} / ${gpuTotal} GPU", "weight": "Bolder", "color": "Good", "horizontalAlignment": "Right" },
            { "type": "TextBlock", "text": "${generation}", "isSubtle": true, "spacing": "None", "size": "Small", "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "Running ${running}", "color": "Good" } ] },
        { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "Pending ${pending}", "color": "Warning" } ] },
        { "type": "Column", "width": "stretch", "$when": "${$host.widgetSize != \"small\"}", "items": [ { "type": "TextBlock", "text": "CPU ${cpuFree}/${cpuTotal}", "horizontalAlignment": "Right" } ] }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${hasNotice}",
      "text": "${notice}",
      "color": "Warning",
      "size": "Small",
      "wrap": true
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize != \"small\"}",
      "$data": "${accounts}",
      "separator": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${alias}  ${status}", "weight": "Bolder" } ] },
            { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "R${running}  Q${pending}  G${runningGpus}", "isSubtle": true } ] },
            {
              "type": "Column",
              "width": "auto",
              "$when": "${needsLogin}",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    { "type": "Action.Execute", "title": "Login", "verb": "refreshAccount", "data": { "account": "${alias}" } }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize == \"large\"}",
      "separator": true,
      "items": [
        { "type": "TextBlock", "text": "GPU NODES", "weight": "Bolder", "size": "Small" },
        {
          "type": "ColumnSet",
          "$data": "${nodes}",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${name}  ${state}", "size": "Small" } ] },
            { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${gpuFree}/${gpuTotal} GPU", "color": "Good", "size": "Small" } ] }
          ]
        },
        { "type": "TextBlock", "text": "${legend}", "isSubtle": true, "size": "Small", "wrap": true }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${$host.widgetSize != \"small\"}",
      "text": "Page ${page} / ${pageCount}",
      "isSubtle": true,
      "size": "Small",
      "horizontalAlignment": "Right"
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Previous", "verb": "previousPage", "$when": "${$host.widgetSize != \"small\"}" },
    { "type": "Action.Execute", "title": "Reload", "verb": "refresh" },
    { "type": "Action.Execute", "title": "Refresh tokens", "verb": "refreshAllTokens" },
    { "type": "Action.Execute", "title": "Next", "verb": "nextPage", "$when": "${$host.widgetSize != \"small\"}" },
    { "type": "Action.Execute", "title": "Dashboard", "verb": "openDashboard", "$when": "${$host.widgetSize == \"large\"}" }
  ]
}
