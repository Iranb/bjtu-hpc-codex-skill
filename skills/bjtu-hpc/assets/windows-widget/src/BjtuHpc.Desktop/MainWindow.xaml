<Window x:Class="BjtuHpc.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BJTU HPC Widget" Width="380" Height="500"
        MinWidth="340" MinHeight="450" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        Topmost="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#F21B1D24" />
        <SolidColorBrush x:Key="InsetBrush" Color="#E6282B35" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9DA3B4" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#323641" />
            <Setter Property="Foreground" Value="#FFF4F6FA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF4F6FA" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource CardBrush}" BorderBrush="#404550" BorderThickness="1"
            CornerRadius="22" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#263B7A57">
                    <TextBlock Text="▦" FontSize="18" Foreground="#55DB97"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="BJTU HPC" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Windows widget · 3.5 / build 19" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="PinButton" Content="●" ToolTip="Toggle always on top" Click="Pin_Click" Margin="0,0,6,0" />
                    <Button Content="↻" ToolTip="Reload snapshot" Click="Refresh_Click" Margin="0,0,6,0" />
                    <Button Content="×" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource InsetBrush}" CornerRadius="16" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GPU AVAILABLE" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding GpuFree}" FontSize="46" FontWeight="Bold" Foreground="#55DB97" />
                            <TextBlock Text="{Binding GpuTotal, StringFormat='/ {0}'}" FontSize="17" Margin="7,0,0,8"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <ProgressBar Minimum="0" Maximum="{Binding GpuTotalSafe, Mode=OneWay}" Value="{Binding GpuFree, Mode=OneWay}"
                                     Height="5" Foreground="#55DB97" Background="#414653" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,2,0,0">
                        <TextBlock Text="{Binding Running, StringFormat='Running  {0}'}" FontSize="13" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding Pending, StringFormat='Pending  {0}'}" FontSize="13" Foreground="#F2B35B" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding CpuText}" FontSize="13" Foreground="#8CB8FF" Margin="0,0,0,7" />
                        <TextBlock Text="{Binding AccountText}" FontSize="11" Foreground="#B59BFF" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#442B2532" CornerRadius="10" Padding="9,6" Margin="0,0,0,10">
                <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#AEB6C8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#FF7777" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Foreground" Value="#F2B35B" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Grid Grid.Row="3" Margin="2,0,2,7">
                <TextBlock Text="ACCOUNT QUEUE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PageText}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="‹" Click="PreviousPage_Click" Padding="7,1" Margin="0,0,4,0" />
                    <Button Content="›" Click="NextPage_Click" Padding="7,1" />
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="4" ItemsSource="{Binding VisibleAccounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#E6333742" CornerRadius="10" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#55DB97" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="LOGIN"><Setter Property="Fill" Value="#B59BFF" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="WARN"><Setter Property="Fill" Value="#F2B35B" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="ERR"><Setter Property="Fill" Value="#FF7777" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Alias}" FontSize="12" FontWeight="SemiBold" Foreground="#FFF4F6FA" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Status, StringFormat='  {0}'}" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Running, StringFormat='R{0}'}" FontSize="11" Foreground="#55DB97" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Pending, StringFormat='Q{0}'}" FontSize="11" Foreground="#F2B35B" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding RunningGpus, StringFormat='G{0}'}" FontSize="11" Foreground="#8CB8FF" />
                                    <Button Content="LOGIN" Tag="{Binding Alias}" Click="Login_Click" FontSize="9" Padding="5,1" Margin="8,-2,0,-2">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsLogin}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="5" Background="#59242830" CornerRadius="12" Padding="10" Margin="0,7,0,9">
                <StackPanel>
                    <TextBlock Text="GPU NODES" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5" />
                    <ItemsControl ItemsSource="{Binding VisibleNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#5E373B46" CornerRadius="7" Padding="7,4" Margin="0,0,6,4">
                                    <TextBlock FontSize="10" Foreground="#FFF4F6FA">
                                        <Run Text="{Binding Name}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding GpuFree}" Foreground="#55DB97" />
                                        <Run Text="/" Foreground="#8F96A8" />
                                        <Run Text="{Binding GpuTotal}" Foreground="#8F96A8" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Row="6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Dashboard" Click="Dashboard_Click" Margin="0,0,6,0" />
                    <Button Content="Refresh all tokens" Click="RefreshAllTokens_Click" />
                </StackPanel>
                <TextBlock Text="{Binding UpdatedText}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
