<Window x:Class="BjtuHpc.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BjtuHpc.Desktop"
        Title="BJTU HPC Widget" Width="480" Height="680"
        MinWidth="440" MinHeight="620" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:WidgetCommands.Reload}" Executed="ReloadCommand_Executed" />
        <CommandBinding Command="{x:Static local:WidgetCommands.OpenDashboard}" Executed="DashboardCommand_Executed" />
        <CommandBinding Command="{x:Static local:WidgetCommands.RefreshTokens}" Executed="RefreshTokensCommand_Executed" />
        <CommandBinding Command="{x:Static local:WidgetCommands.TogglePin}" Executed="TogglePinCommand_Executed" />
        <CommandBinding Command="{x:Static local:WidgetCommands.Close}" Executed="CloseCommand_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="{x:Static local:WidgetCommands.Reload}" Gesture="Ctrl+R" />
        <KeyBinding Command="{x:Static local:WidgetCommands.OpenDashboard}" Gesture="Ctrl+D" />
        <KeyBinding Command="{x:Static local:WidgetCommands.RefreshTokens}" Gesture="Ctrl+T" />
        <KeyBinding Command="{x:Static local:WidgetCommands.Close}" Gesture="Esc" />
    </Window.InputBindings>

    <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="24" Padding="18" Effect="{StaticResource WindowShadow}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="12" Background="#1F3B82F6"
                        BorderBrush="#553B82F6" BorderThickness="1">
                    <Viewbox Width="21" Height="21">
                        <Path Stroke="{StaticResource PrimaryHoverBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 3,12 L 7,12 M 9,12 L 13,12 M 15,12 L 19,12 M 5,9 L 5,15 M 11,7 L 11,17 M 17,5 L 17,19" />
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="BJTU HPC" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Operations monitor  &#183;  v3.5.19" FontSize="10.5"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}"
                            Command="{x:Static local:WidgetCommands.TogglePin}"
                            ToolTip="Toggle always on top" AutomationProperties.Name="Toggle always on top">
                        <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 7,3 L 17,3 L 15,8 L 18,11 L 18,13 L 13,13 L 13,21 L 11,21 L 11,13 L 6,13 L 6,11 L 9,8 Z" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                            Command="{x:Static local:WidgetCommands.Reload}"
                            ToolTip="Reload snapshot (Ctrl+R)" AutomationProperties.Name="Reload snapshot">
                        <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 18,8 A 7,7 0 1 0 19,13 M 18,4 L 18,8 L 14,8" />
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Margin="2,0,0,0"
                            Command="{x:Static local:WidgetCommands.Close}"
                            ToolTip="Hide to notification area (Esc)" AutomationProperties.Name="Hide widget to notification area">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round"
                              Data="M 4,4 L 16,16 M 16,4 L 4,16" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Height="240" Padding="16" Margin="0,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#172743" Offset="0" />
                        <GradientStop Color="#101827" Offset="0.62" />
                        <GradientStop Color="#101C2C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="CLUSTER CAPACITY" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <Border HorizontalAlignment="Right" CornerRadius="9" Padding="8,3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1F34D399" />
                                    <Setter Property="BorderBrush" Value="#5534D399" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                            <Setter Property="Background" Value="#24FBBF24" />
                                            <Setter Property="BorderBrush" Value="#66FBBF24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Background" Value="#24FB7185" />
                                            <Setter Property="BorderBrush" Value="#66FB7185" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding HealthLabel}" FontSize="9" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding GpuFree}" FontFamily="Cascadia Mono, Consolas" FontSize="50"
                                   FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,8">
                            <TextBlock Text="{Binding GpuTotal, StringFormat='of {0}'}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="GPU available" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding GpuPercentText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,0,9" FontSize="11"
                                   Foreground="{StaticResource CyanBrush}" />
                    </Grid>

                    <ProgressBar Grid.Row="2" Minimum="0" Maximum="{Binding GpuTotalSafe, Mode=OneWay}"
                                 Value="{Binding GpuFree, Mode=OneWay}" AutomationProperties.Name="Available GPU capacity" />

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RUNNING" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Running}" FontFamily="Cascadia Mono, Consolas" FontSize="18"
                                       FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PENDING" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding Pending}" FontFamily="Cascadia Mono, Consolas" FontSize="18"
                                       FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CPU AVAILABLE" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{Binding CpuCapacityText}" FontFamily="Cascadia Mono, Consolas" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryHoverBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" CornerRadius="10" Padding="10,7" Margin="0,0,0,13"
                    Background="#171F2F" BorderBrush="#263652" BorderThickness="1"
                    AutomationProperties.LiveSetting="Polite">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Margin="1,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10.5"
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="2,0,2,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ACCOUNTS" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding AccountText, StringFormat='  {0}'}" FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding PageText}" FontFamily="Cascadia Mono, Consolas" FontSize="9"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Style="{StaticResource PageButtonStyle}" Click="PreviousPage_Click"
                            ToolTip="Previous accounts" AutomationProperties.Name="Previous accounts">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 14,3 L 6,10 L 14,17" />
                    </Button>
                    <Button Style="{StaticResource PageButtonStyle}" Click="NextPage_Click" Margin="4,0,0,0"
                            ToolTip="Next accounts" AutomationProperties.Name="Next accounts">
                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 6,3 L 14,10 L 6,17" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleAccounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowCardStyle}" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="LOGIN"><Setter Property="Fill" Value="{StaticResource AttentionBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="WARN"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="ERR"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Alias}" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Status}" FontSize="8.5" FontWeight="Bold" Margin="14,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="LOGIN"><Setter Property="Foreground" Value="{StaticResource AttentionBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="WARN"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ERR"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="RUN" FontSize="8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Running}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="WAIT" FontSize="8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Pending}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="GPU" FontSize="8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding RunningGpus}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource PrimaryHoverBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Sign in" Tag="{Binding Alias}" Click="Login_Click"
                                            Margin="12,0,0,0"
                                            AutomationProperties.Name="Sign in to account">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AttentionButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NeedsLogin}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="5" Background="#121C2C" BorderBrush="#24344F" BorderThickness="1"
                    CornerRadius="12" Padding="11,8" Margin="0,6,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NODES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#18243A" CornerRadius="7" Padding="7,4" Margin="0,0,5,3">
                                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="9">
                                        <Run Text="{Binding Name}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding GpuFree}" Foreground="{StaticResource CyanBrush}" />
                                        <Run Text="/" Foreground="{StaticResource MutedTextBrush}" />
                                        <Run Text="{Binding GpuTotal}" Foreground="{StaticResource MutedTextBrush}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open dashboard" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Static local:WidgetCommands.OpenDashboard}"
                            ToolTip="Open dashboard (Ctrl+D)" AutomationProperties.Name="Open dashboard" />
                    <Button Content="Refresh tokens" Style="{StaticResource AttentionButtonStyle}" Margin="7,0,0,0"
                            Command="{x:Static local:WidgetCommands.RefreshTokens}"
                            ToolTip="Refresh all tokens (Ctrl+T)" AutomationProperties.Name="Refresh all account tokens" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdatedText}" FontSize="8.5" Foreground="{StaticResource MutedTextBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="Ctrl+R to reload" FontSize="8" Foreground="#64748B" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
