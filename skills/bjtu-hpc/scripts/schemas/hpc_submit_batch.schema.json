{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bjtu-hpc.invalid/schemas/hpc_submit_batch.schema.json",
  "title": "BJTU HPC refresh-gated submit cycle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cycle_id", "project_slug", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "cycle_id": {"type": "string", "pattern": "^cycle_[0-9a-f]{12,16}$"},
    "project_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "max_admissions": {"type": "integer", "minimum": 1, "maximum": 8, "default": 8},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpus", "ntasks", "cpus_per_task"],
      "properties": {
        "gpus": {"type": "integer", "minimum": 1, "maximum": 8},
        "ntasks": {"type": "integer", "minimum": 1, "maximum": 64},
        "cpus_per_task": {"type": "integer", "minimum": 1, "maximum": 48},
        "total_cpus": {"type": "integer", "minimum": 1, "maximum": 240}
      }
    },
    "remote_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "root"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "root": {"type": "string", "pattern": "^/"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_account", "script", "submit_intent_ref", "expected", "required_remote_paths"],
      "properties": {
        "auth_account": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "script": {"type": "string", "minLength": 1},
        "submit_intent_ref": {"type": "string", "minLength": 1},
        "expected": {"$ref": "#/$defs/expected"},
        "required_remote_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/remote_path"}
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "priority", "kind", "experiment_family_id", "seeds", "candidates"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^item_[0-9a-f]{12,16}$"},
        "priority": {"type": "integer"},
        "kind": {"enum": ["independent", "array"]},
        "experiment_family_id": {"type": "string", "pattern": "^family_[0-9a-f]{12,64}$"},
        "seeds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/candidate"}
        }
      }
    }
  }
}
