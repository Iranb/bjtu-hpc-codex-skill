{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoreskill.local/schemas/hpc_data_supply_verify_report.schema.json",
  "title": "AutoResearch HPC Data Supply Verify Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "intent_id",
    "plan_sha256",
    "artifact_schema",
    "artifact_content_sha256",
    "dataset_semantics_sha256",
    "source_inventory_sha256",
    "artifact_build_contract_sha256",
    "converter_bundle_sha256",
    "consumer_contract_sha256",
    "validator_bundle_sha256",
    "validation_attestation_id",
    "validation_report_sha256",
    "native_provider_bundle_sha256",
    "remote_mutation_receipt_sha256",
    "storage_owner",
    "final_root",
    "shards",
    "readable_accounts",
    "core_marker_verified",
    "attestation_ready_verified",
    "verified_at",
    "registry_revision"
  ],
  "properties": {
    "schema": {"const": "autoreskill.hpc_data_supply_verify_report.v1"},
    "intent_id": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_schema": {"const": "image_bytes_indexed_v1"},
    "artifact_content_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_semantics_sha256": {"$ref": "#/$defs/sha256"},
    "source_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_build_contract_sha256": {"$ref": "#/$defs/sha256"},
    "converter_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "consumer_contract_sha256": {"$ref": "#/$defs/sha256"},
    "validator_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "validation_attestation_id": {"$ref": "#/$defs/sha256"},
    "validation_report_sha256": {"$ref": "#/$defs/sha256"},
    "native_provider_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "remote_mutation_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "storage_owner": {"type": "object"},
    "final_root": {"type": "string", "pattern": "^/"},
    "shards": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "readable_accounts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "core_marker_verified": {"const": true},
    "attestation_ready_verified": {"const": true},
    "verified_at": {"type": "string", "minLength": 1},
    "registry_revision": {"type": "integer", "minimum": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
