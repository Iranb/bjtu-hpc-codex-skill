{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoreskill.local/schemas/data_validation_attestation.schema.json",
  "title": "AutoResearch Data Validation Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_content_sha256",
    "consumer_contract_sha256",
    "validator_bundle_sha256",
    "validation_report_sha256",
    "validation_attestation_id"
  ],
  "properties": {
    "schema": {"const": "autoreskill.data_validation_attestation.v1"},
    "artifact_content_sha256": {"$ref": "#/$defs/sha256"},
    "consumer_contract_sha256": {"$ref": "#/$defs/sha256"},
    "validator_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "validation_report_sha256": {"$ref": "#/$defs/sha256"},
    "validation_attestation_id": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
